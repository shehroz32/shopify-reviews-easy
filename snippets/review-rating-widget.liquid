
{% comment %}
  Reusable Product Rating Widget

  Usage anywhere in Shopify theme:

  {% render 'review-rating-widget', product: product %}

  Product cards:

  {% render 'review-rating-widget', product: card_product %}
{% endcomment %}

{% if product %}

<style>
  .review-rating-widget {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    width: fit-content;
    line-height: 1;
    font-family: inherit;
  }

  .review-rating-widget__stars {
    display: inline-flex;
    align-items: center;
    gap: 1px;
  }

  .review-rating-widget__stars .rating-star {
    position: relative;
    display: inline-block;
    width: 29px;
    height: 31px;
    font-family: Arial, sans-serif;
    font-size: 31px;
    line-height: 31px;
    color: #cfd4d8;
  }

  .review-rating-widget__stars .rating-star.full {
    color: #e87500;
  }

  .review-rating-widget__stars .rating-star.half {
    color: #cfd4d8;
  }

  .review-rating-widget__stars .rating-star.half::before {
    content: "★";
    position: absolute;
    left: 0;
    top: 0;
    width: 50%;
    height: 100%;
    overflow: hidden;
    color: #e87500;
  }

  .review-rating-widget__average {
    margin-left: 5px;
    color: #111;
    font-size: 29px;
    font-weight: 400;
    line-height: 1;
    white-space: nowrap;
  }

  .review-rating-widget__separator {
    color: #777;
    font-size: 16px;
    line-height: 1;
  }

  .review-rating-widget__ratings,
  .review-rating-widget__reviews {
    color: #777;
    font-size: 14px;
    line-height: 1;
    white-space: nowrap;
  }

  .review-rating-widget.is-loading {
    opacity: 0.65;
  }

  @media screen and (max-width: 749px) {

    .review-rating-widget {
      gap: 5px;
    }

    .review-rating-widget__stars .rating-star {
      width: 23px;
      height: 25px;
      font-size: 25px;
      line-height: 25px;
    }

    .review-rating-widget__average {
      font-size: 23px;
    }

    .review-rating-widget__ratings,
    .review-rating-widget__reviews {
      font-size: 12px;
    }
  }
</style>


<div
  class="review-rating-widget"
  data-product-id="{{ product.id }}"
  data-api-url="https://shopify-reviews-easy.vercel.app/api/reviews"
>

  <div
    class="review-rating-widget__stars"
    aria-label="Product rating"
  >
    <span class="rating-star" data-star="1">★</span>
    <span class="rating-star" data-star="2">★</span>
    <span class="rating-star" data-star="3">★</span>
    <span class="rating-star" data-star="4">★</span>
    <span class="rating-star" data-star="5">★</span>
  </div>

  <span class="review-rating-widget__average">
    0.00
  </span>

  <span class="review-rating-widget__separator">
    ·
  </span>

  <span class="review-rating-widget__ratings">
    0 ratings
  </span>

  <span class="review-rating-widget__separator">
    ·
  </span>

  <span class="review-rating-widget__reviews">
    0 reviews
  </span>

</div>


<script>
(function () {

  "use strict";

  function loadRatingWidget(widget) {

    const productId = widget.dataset.productId;
    const apiUrl = widget.dataset.apiUrl;

    if (!productId || !apiUrl) {
      return;
    }

    const stars = widget.querySelectorAll(".rating-star");
    const averageEl = widget.querySelector(
      ".review-rating-widget__average"
    );

    const ratingsEl = widget.querySelector(
      ".review-rating-widget__ratings"
    );

    const reviewsEl = widget.querySelector(
      ".review-rating-widget__reviews"
    );

    widget.classList.add("is-loading");

    fetch(
      apiUrl + "?productId=" + encodeURIComponent(productId),
      {
        method: "GET",
        headers: {
          "Accept": "application/json"
        }
      }
    )
      .then(function (response) {

        if (!response.ok) {
          throw new Error(
            "HTTP " + response.status
          );
        }

        return response.json();
      })

      .then(function (data) {

        const average = Number(
          data.average || 0
        );

        const total = Number(
          data.total || 0
        );

        /*
         * Average rating
         * Example: 3.66
         */
        averageEl.textContent =
          average.toFixed(2);


        /*
         * Current API returns one total count.
         */
        ratingsEl.textContent =
          total.toLocaleString() + " ratings";

        reviewsEl.textContent =
          total.toLocaleString() + " reviews";


        /*
         * Render stars
         */
        stars.forEach(function (star, index) {

          const starNumber = index + 1;

          star.classList.remove(
            "full",
            "half"
          );

          if (average >= starNumber) {

            star.classList.add("full");

          } else if (
            average >= starNumber - 0.5
          ) {

            star.classList.add("half");

          }

        });

      })

      .catch(function (error) {

        console.error(
          "Review Rating Widget:",
          error
        );

        averageEl.textContent = "0.00";

        ratingsEl.textContent =
          "0 ratings";

        reviewsEl.textContent =
          "0 reviews";

        stars.forEach(function (star) {

          star.classList.remove(
            "full",
            "half"
          );

        });

      })

      .finally(function () {

        widget.classList.remove(
          "is-loading"
        );

      });
  }


  function initReviewRatingWidgets() {

    const widgets =
      document.querySelectorAll(
        ".review-rating-widget"
      );

    widgets.forEach(function (widget) {

      /*
       * Prevent duplicate initialization
       */
      if (
        widget.dataset.ratingLoaded === "true"
      ) {
        return;
      }

      widget.dataset.ratingLoaded = "true";

      loadRatingWidget(widget);

    });

  }


  /*
   * Normal page load
   */
  if (
    document.readyState === "loading"
  ) {

    document.addEventListener(
      "DOMContentLoaded",
      initReviewRatingWidgets
    );

  } else {

    initReviewRatingWidgets();

  }


  /*
   * Shopify Theme Editor
   */
  document.addEventListener(
    "shopify:section:load",
    function () {

      initReviewRatingWidgets();

    }
  );

})();
</script>

{% endif %}
