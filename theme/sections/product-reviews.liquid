
{{ 'product-reviews.css' | asset_url | stylesheet_tag }}

<div
  class="reviews-app"
  id="reviews-app"
  data-product-id="{{ product.id }}"
  data-api-url="https://YOUR-VERCEL-APP.vercel.app/api/reviews"
>
  <div class="reviews-app__header">
    <h2>What do you think?</h2>
    <div class="reviews-app__summary-stars" id="reviews-summary-stars">☆☆☆☆☆</div>
    <button class="reviews-app__write-btn" id="open-review-form">Write a Review</button>
  </div>

  <div class="reviews-app__breakdown" id="reviews-breakdown">
    <!-- JS fills this in: bar per star rating -->
  </div>

  <!-- Write a review form (hidden until button clicked) -->
  <div class="reviews-app__form-wrap" id="review-form-wrap" hidden>
    <form id="review-form">
      <h3>Write a Review</h3>

      <label>Your Rating</label>
      <div class="reviews-app__star-input" id="star-input">
        <span data-star="1">☆</span>
        <span data-star="2">☆</span>
        <span data-star="3">☆</span>
        <span data-star="4">☆</span>
        <span data-star="5">☆</span>
      </div>
      <input type="hidden" id="rating-value" name="rating" required>

      <label for="review-name">Your Name</label>
      <input type="text" id="review-name" name="name" required maxlength="80">

      <label for="review-title">Review Title</label>
      <input type="text" id="review-title" name="title" maxlength="120">

      <label for="review-body">Your Review</label>
      <textarea id="review-body" name="body" rows="4" required maxlength="2000"></textarea>

      <div class="reviews-app__form-actions">
        <button type="submit" id="submit-review">Submit Review</button>
        <button type="button" id="cancel-review">Cancel</button>
      </div>
      <p class="reviews-app__msg" id="review-msg"></p>
    </form>
  </div>

  <div class="reviews-app__list" id="reviews-list">
    <p class="reviews-app__loading">Loading reviews...</p>
  </div>
</div>

{{ 'product-reviews.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "Product Reviews",
  "target": "section",
  "settings": [],
  "presets": [
    { "name": "Product Reviews" }
  ]
}
{% endschema %}
